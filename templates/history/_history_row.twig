<article class="history-row{% if play.exceedsRuntime %} is-over-runtime{% endif %}" data-history-id="{{ play.id }}">
    <div class="history-time">{{ play.time }}</div>
    <div class="history-user">
        {% include "_avatar.twig" with { initials: play.initials, url: play.avatarUrl } only %}
        <strong>{{ play.user }}</strong>
    </div>
    <div class="history-item">
        <span class="history-poster" style="background-image: {{ play.poster }}"></span>
        <span>
            <strong>{{ play.title }}</strong>
            <small>{{ play.sub }}</small>
        </span>
    </div>
    <div class="history-method">{% include "_badge.twig" with { item: play } %}</div>
    <div class="history-mono">{{ play.client }}</div>
    <div class="history-mono is-muted">{{ play.device }}</div>
    <div class="history-watched">
        <strong>{{ play.watchedLabel }}{% if play.exceedsRuntime %}<span class="history-over-flag" title="Watched time exceeds title runtime" aria-label="Watched time exceeds title runtime">!</span>{% endif %}{% if play.finished %}<span aria-label="Finished">&#10003;</span>{% endif %}</strong>
        <div class="mini-track"><span style="width: {{ play.completionPct }}%"></span></div>
    </div>
    <div class="history-actions">
        <button type="button" class="history-action is-edit" data-history-edit="{{ play.id }}" aria-label="Edit play" title="Edit">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
            </svg>
        </button>
        <button type="button" class="history-action is-delete" data-history-delete-row="{{ play.id }}" aria-label="Delete play" title="Delete">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M4 7h16"></path>
                <path d="M10 7V5h4v2"></path>
                <path d="M6 7l1 12h10l1-12"></path>
                <path d="M10 11v6"></path>
                <path d="M14 11v6"></path>
            </svg>
        </button>
    </div>
</article>
